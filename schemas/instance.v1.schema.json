{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algotrace.example/schemas/instance.v1.schema.json",
  "title": "AlgoTrace task instance v1",
  "description": "One task instance, one JSON object per line of instances/<name>.jsonl. Generated once before a series; the environment, the reference algorithms and the analyzer read the same file, so no module has to repeat a random generator.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.v1.schema.json#/$defs/schema_version" },
    "instance_id": {
      "description": "Unique in the file, e.g. sort-n5-000.",
      "$ref": "common.v1.schema.json#/$defs/slug"
    },
    "task": { "$ref": "common.v1.schema.json#/$defs/task" },
    "n": {
      "description": "Size: array length (sort, search) or number of disks (hanoi).",
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "description": "Seed the instance was generated from (base_seed + index); null for a hand-made instance.",
      "type": ["integer", "null"],
      "minimum": 0
    },
    "generator": {
      "description": "Generator name and version; null for a hand-made instance. The state below, not the seed, is the instance.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        }
      ]
    },
    "state": { "$ref": "common.v1.schema.json#/$defs/state" }
  },
  "required": ["schema_version", "instance_id", "task", "n", "seed", "generator", "state"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "task": { "const": "sort" } } },
      "then": { "properties": { "state": { "$ref": "common.v1.schema.json#/$defs/sort_state" } } }
    },
    {
      "if": { "properties": { "task": { "const": "hanoi" } } },
      "then": { "properties": { "state": { "$ref": "common.v1.schema.json#/$defs/hanoi_state" } } }
    },
    {
      "if": { "properties": { "task": { "const": "search" } } },
      "then": { "properties": { "state": { "$ref": "common.v1.schema.json#/$defs/search_state" } } }
    }
  ]
}
