{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algotrace.example/schemas/run-event.v2.schema.json",
  "title": "AlgoTrace run event v2",
  "description": "One line of a run log <runs_dir>/<run_id>.jsonl: run_start first, then model_turn and tool_call events in the order they happened, run_end last. Written by the environment and the runner, read by the analyzer and the analysis.",
  "oneOf": [
    { "$ref": "#/$defs/run_start" },
    { "$ref": "#/$defs/model_turn" },
    { "$ref": "#/$defs/tool_call" },
    { "$ref": "#/$defs/run_end" }
  ],
  "$defs": {
    "run_start": {
      "description": "Once, the first line: the run, its instance and everything needed to repeat it.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "common.v2.schema.json#/$defs/schema_version" },
        "event": { "const": "run_start" },
        "run_id": { "$ref": "common.v2.schema.json#/$defs/run_id" },
        "run_attempt": { "$ref": "common.v2.schema.json#/$defs/run_attempt" },
        "ts": { "$ref": "common.v2.schema.json#/$defs/timestamp" },
        "series": { "$ref": "common.v2.schema.json#/$defs/series" },
        "series_id": { "$ref": "common.v2.schema.json#/$defs/slug" },
        "config_sha256": {
          "description": "SHA-256 of the canonical JSON (RFC 8785) of the experiment configuration.",
          "$ref": "common.v2.schema.json#/$defs/sha256"
        },
        "condition": { "$ref": "common.v2.schema.json#/$defs/condition" },
        "model_key": { "$ref": "common.v2.schema.json#/$defs/slug" },
        "provider": { "$ref": "common.v2.schema.json#/$defs/provider" },
        "model_requested": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "api_version": { "type": ["string", "null"] },
        "settings_sent": {
          "description": "Generation parameters exactly as sent to the API (provider names), without secrets and headers.",
          "$ref": "common.v2.schema.json#/$defs/secret_free_object"
        },
        "parallel_tool_calls": {
          "description": "Several tool calls in one turn are allowed and executed one after another (protocol D04 A); the only value of v2.",
          "type": "boolean",
          "const": true
        },
        "strict_tools": {
          "description": "The tool definitions were sent with strict: true (only where the API has it, protocol prompts.md section 8).",
          "type": "boolean"
        },
        "task": { "$ref": "common.v2.schema.json#/$defs/task" },
        "n": { "type": "integer", "minimum": 1 },
        "instance_id": { "$ref": "common.v2.schema.json#/$defs/slug" },
        "instance_seed": { "type": ["integer", "null"], "minimum": 0 },
        "repetition": {
          "description": "Repeat of the same (model, instance) from 1; the protocol gives every repetition of a cell its own instance (instance rep), so it uses repetitions: 1.",
          "type": "integer",
          "minimum": 1
        },
        "initial_state": { "$ref": "common.v2.schema.json#/$defs/state" },
        "prompt": {
          "type": "object",
          "properties": {
            "prompt_id": { "$ref": "common.v2.schema.json#/$defs/slug" },
            "prompt_variant": { "$ref": "common.v2.schema.json#/$defs/prompt_variant" },
            "language": { "type": "string", "pattern": "^[a-z]{2}$" },
            "announcement_requested": { "type": "boolean" },
            "sha256": {
              "description": "SHA-256 of the UTF-8 text sent before the first turn: system prompt, one LF, task description with the values of the instance.",
              "$ref": "common.v2.schema.json#/$defs/sha256"
            }
          },
          "required": ["prompt_id", "prompt_variant", "language", "announcement_requested", "sha256"],
          "additionalProperties": false,
          "if": { "properties": { "prompt_variant": { "const": "no_announcement" } } },
          "then": { "properties": { "announcement_requested": { "const": false } } },
          "else": { "properties": { "announcement_requested": { "const": true } } }
        },
        "tools": {
          "type": "object",
          "properties": {
            "tool_set": { "$ref": "common.v2.schema.json#/$defs/slug" },
            "names": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            },
            "compare_result_format": { "enum": ["words", "symbols", null] },
            "sha256": {
              "description": "SHA-256 of the canonical JSON (RFC 8785) of the tool definitions in the neutral form (names, descriptions, parameter schemas), before the adapter converts them.",
              "$ref": "common.v2.schema.json#/$defs/sha256"
            }
          },
          "required": ["tool_set", "names", "compare_result_format", "sha256"],
          "additionalProperties": false
        },
        "limits": { "$ref": "common.v2.schema.json#/$defs/run_limits" },
        "faults": {
          "description": "Injected fault of this run (protocol fault-injection.md, section 6): the type and length of the configuration, the schedule of the instance; null in the condition main.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "fault_type": { "$ref": "common.v2.schema.json#/$defs/fault_type" },
                "fault_length": { "type": "integer", "minimum": 1 },
                "fault_seed": { "type": "integer", "minimum": 0 },
                "fault_position": { "type": "integer", "minimum": 1 },
                "message": { "type": "string", "minLength": 1 }
              },
              "required": ["fault_type", "fault_length", "fault_seed", "fault_position", "message"],
              "additionalProperties": false,
              "if": { "properties": { "fault_type": { "const": "one_off" } } },
              "then": { "properties": { "fault_length": { "const": 1 } } }
            }
          ]
        },
        "price": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.v2.schema.json#/$defs/price" }
          ]
        },
        "env_version": { "type": "string", "minLength": 1 },
        "runner_version": { "type": "string", "minLength": 1 },
        "software": {
          "description": "Where the run ran; null = unknown.",
          "type": "object",
          "properties": {
            "git_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
            "git_dirty": { "type": ["boolean", "null"] },
            "runtime": { "type": "string", "minLength": 1 },
            "os": { "type": "string", "minLength": 1 },
            "lock_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "common.v2.schema.json#/$defs/sha256" }] },
            "local_server": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "properties": {
                    "server": { "type": "string", "minLength": 1 },
                    "server_version": { "type": "string", "minLength": 1 },
                    "context_length": { "type": "integer", "minimum": 1 },
                    "quantization": { "type": ["string", "null"] }
                  },
                  "required": ["server", "server_version", "context_length", "quantization"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["git_commit", "git_dirty", "runtime", "os", "lock_sha256", "local_server"],
          "additionalProperties": false
        }
      },
      "required": ["schema_version", "event", "run_id", "run_attempt", "ts", "series", "series_id", "config_sha256", "condition", "model_key", "provider", "model_requested", "model_version", "api_version", "settings_sent", "parallel_tool_calls", "strict_tools", "task", "n", "instance_id", "instance_seed", "repetition", "initial_state", "prompt", "tools", "limits", "faults", "price", "env_version", "runner_version", "software"],
      "additionalProperties": false,
      "if": { "properties": { "condition": { "const": "faults" } } },
      "then": { "properties": { "faults": { "type": "object" } } },
      "else": { "properties": { "faults": { "type": "null" } } }
    },
    "model_turn": {
      "description": "Every response of the model (a turn), written before the tool_call events of that turn.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "common.v2.schema.json#/$defs/schema_version" },
        "event": { "const": "model_turn" },
        "run_id": { "$ref": "common.v2.schema.json#/$defs/run_id" },
        "ts": { "$ref": "common.v2.schema.json#/$defs/timestamp" },
        "turn": {
          "description": "Number of the model response, from 1.",
          "type": "integer",
          "minimum": 1
        },
        "input_kind": {
          "description": "What the model answered: task = the first prompt, tool_results = results of the previous turn's calls, reminder = the reminder after a turn without a tool call.",
          "enum": ["task", "tool_results", "reminder"]
        },
        "model_returned": { "type": "string", "minLength": 1 },
        "response_id": { "type": ["string", "null"] },
        "system_fingerprint": { "type": ["string", "null"] },
        "finish_reason": { "$ref": "common.v2.schema.json#/$defs/finish_reason" },
        "finish_reason_raw": { "type": ["string", "null"] },
        "text": {
          "description": "All visible text of the response (e.g. the announcement of the algorithm, protocol D01); null when there is none.",
          "type": ["string", "null"]
        },
        "reasoning_text": {
          "description": "Reasoning or its summary when the provider returns it; null otherwise.",
          "type": ["string", "null"]
        },
        "tool_calls": {
          "description": "Tool calls of the response in their order; [] for a turn without a call. Every call has its tool_call event, also a skipped one.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "arguments_raw": {
                "description": "Arguments exactly as the model sent them (a JSON text, possibly invalid).",
                "type": "string"
              },
              "index_in_turn": { "type": "integer", "minimum": 0 }
            },
            "required": ["id", "name", "arguments_raw", "index_in_turn"],
            "additionalProperties": false
          }
        },
        "usage": { "$ref": "common.v2.schema.json#/$defs/usage" },
        "cost": {
          "description": "Nominal cost of this response from its usage and the price of run_start (formula in price of common); the budget guard checks it after every response (protocol run-settings.md, section 7).",
          "$ref": "common.v2.schema.json#/$defs/optional_cost"
        },
        "latency_ms": {
          "description": "Time of the successful API call (monotonic clock), without the waits of retries.",
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "description": "API calls made for this turn; 1 = no retry.",
          "type": "integer",
          "minimum": 1
        },
        "retries": {
          "description": "Failed attempts before the successful one.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": ["integer", "null"] },
              "error_type": { "type": "string", "minLength": 1 },
              "wait_ms": { "type": "integer", "minimum": 0 }
            },
            "required": ["status", "error_type", "wait_ms"],
            "additionalProperties": false
          }
        },
        "raw_ref": {
          "description": "Line in <run_id>.raw.jsonl with the raw request and response, e.g. <run_id>.raw.jsonl#3; null when raw logging is off.",
          "type": ["string", "null"]
        }
      },
      "required": ["schema_version", "event", "run_id", "ts", "turn", "input_kind", "model_returned", "response_id", "finish_reason", "finish_reason_raw", "text", "tool_calls", "usage", "cost", "latency_ms", "attempts", "raw_ref"],
      "additionalProperties": false
    },
    "tool_call": {
      "description": "Every tool call of every turn in the order of the turn: a step (executed, rejected by validation or with an injected fault) or a call skipped after the run ended in the same turn.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "common.v2.schema.json#/$defs/schema_version" },
        "event": { "const": "tool_call" },
        "run_id": { "$ref": "common.v2.schema.json#/$defs/run_id" },
        "ts": { "$ref": "common.v2.schema.json#/$defs/timestamp" },
        "step": {
          "description": "Number of the step in the run, from 1 (executed, rejected or with an injected fault); null exactly for a skipped call.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "turn": { "type": "integer", "minimum": 1 },
        "index_in_turn": {
          "description": "Position of the call in its turn, from 0 (protocol D04).",
          "type": "integer",
          "minimum": 0
        },
        "call_id": { "type": "string", "minLength": 1 },
        "tool": {
          "description": "Tool name as the model sent it (may be unknown).",
          "type": "string"
        },
        "arguments": {
          "description": "Parsed arguments; null when arguments_raw is not a JSON object.",
          "type": ["object", "null"]
        },
        "executed": {
          "description": "true = the tool ran and may have changed the state.",
          "type": "boolean"
        },
        "validation_error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.v2.schema.json#/$defs/validation_error" }
          ]
        },
        "validation_detail": {
          "description": "Detail of an illegal_move; null for every other call.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.v2.schema.json#/$defs/validation_detail" }
          ]
        },
        "injected_fault": {
          "description": "Fault injected by the environment instead of running a valid call (protocol fault-injection.md, section 6); never mixed with validation_error. event_index = 1..fault_length within the fault event.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "type": { "$ref": "common.v2.schema.json#/$defs/fault_type" },
                "event_index": { "type": "integer", "minimum": 1 }
              },
              "required": ["type", "event_index"],
              "additionalProperties": false
            }
          ]
        },
        "skipped_reason": {
          "description": "Set when the call was not processed because the run ended on an earlier call of the same turn; null for every step.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.v2.schema.json#/$defs/skipped_reason" }
          ]
        },
        "is_error": {
          "description": "The result was sent to the model as an error (is_error).",
          "type": "boolean"
        },
        "result": {
          "description": "Result text exactly as the environment produced it for the model (after_done: recorded only); null exactly for a skipped call.",
          "type": ["string", "null"]
        },
        "state_after": {
          "description": "Full hidden state after the call; null only when the task never changes its state (search).",
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.v2.schema.json#/$defs/state" }
          ]
        }
      },
      "required": ["schema_version", "event", "run_id", "ts", "step", "turn", "index_in_turn", "call_id", "tool", "arguments", "executed", "validation_error", "validation_detail", "injected_fault", "skipped_reason", "is_error", "result", "state_after"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "validation_error": { "const": "illegal_move" } } },
          "then": { "properties": { "validation_detail": { "type": "string" } } },
          "else": { "properties": { "validation_detail": { "type": "null" } } }
        },
        {
          "if": { "properties": { "validation_error": { "type": "string" } } },
          "then": { "properties": { "executed": { "const": false }, "is_error": { "const": true }, "injected_fault": { "type": "null" } } }
        },
        {
          "if": { "properties": { "injected_fault": { "type": "object" } } },
          "then": { "properties": { "executed": { "const": false }, "is_error": { "const": true } } }
        },
        {
          "if": { "properties": { "executed": { "const": true } } },
          "then": { "properties": { "is_error": { "const": false }, "validation_error": { "type": "null" }, "injected_fault": { "type": "null" } } }
        },
        {
          "description": "A skipped call has no step number and no result, and is neither executed nor rejected.",
          "if": { "properties": { "skipped_reason": { "type": "string" } } },
          "then": { "properties": { "step": { "type": "null" }, "executed": { "const": false }, "validation_error": { "type": "null" }, "injected_fault": { "type": "null" }, "is_error": { "const": false }, "result": { "type": "null" } } },
          "else": { "properties": { "step": { "type": "integer" }, "result": { "type": "string" } } }
        }
      ]
    },
    "run_end": {
      "description": "Once, the last line. A log without run_end is an interrupted run.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "common.v2.schema.json#/$defs/schema_version" },
        "event": { "const": "run_end" },
        "run_id": { "$ref": "common.v2.schema.json#/$defs/run_id" },
        "ts": { "$ref": "common.v2.schema.json#/$defs/timestamp" },
        "end_reason": { "$ref": "common.v2.schema.json#/$defs/end_reason" },
        "solved": {
          "description": "The goal state was reached at the end, whether or not the model called done.",
          "type": "boolean"
        },
        "done_called": { "type": "boolean" },
        "final_state": { "$ref": "common.v2.schema.json#/$defs/state" },
        "steps": {
          "description": "Number of tool_call events with a step number (skipped calls not counted).",
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "description": "Number of model_turn events.",
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "properties": {
            "executed_by_tool": {
              "description": "Executed calls per tool name (done included).",
              "type": "object",
              "additionalProperties": { "$ref": "common.v2.schema.json#/$defs/non_negative_integer" }
            },
            "validation_errors": { "$ref": "common.v2.schema.json#/$defs/non_negative_integer" },
            "by_validation_error": {
              "type": "object",
              "propertyNames": { "$ref": "common.v2.schema.json#/$defs/validation_error" },
              "additionalProperties": { "$ref": "common.v2.schema.json#/$defs/non_negative_integer" }
            },
            "injected_faults": {
              "description": "Calls with an injected fault; fault_fired of the protocol = injected_faults > 0 (condition faults).",
              "$ref": "common.v2.schema.json#/$defs/non_negative_integer"
            },
            "skipped_calls": {
              "description": "Calls skipped after the end of the run in the last turn.",
              "$ref": "common.v2.schema.json#/$defs/non_negative_integer"
            },
            "text_turns": {
              "description": "Turns without a tool call.",
              "$ref": "common.v2.schema.json#/$defs/non_negative_integer"
            },
            "reminders": { "$ref": "common.v2.schema.json#/$defs/non_negative_integer" },
            "parallel_turns": {
              "description": "Turns with more than one tool call.",
              "$ref": "common.v2.schema.json#/$defs/non_negative_integer"
            }
          },
          "required": ["executed_by_tool", "validation_errors", "by_validation_error", "injected_faults", "skipped_calls", "text_turns", "reminders", "parallel_turns"],
          "additionalProperties": false
        },
        "usage_total": { "$ref": "common.v2.schema.json#/$defs/usage" },
        "cost": {
          "description": "Sum of the cost of the turns; null when the price is null.",
          "$ref": "common.v2.schema.json#/$defs/optional_cost"
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "error": {
          "description": "Error that ended the run (api_error, context_exceeded, interrupted); null otherwise. type daily_limit = the provider's daily limit: the repeat does not use up max_run_retries (protocol run-settings.md, section 6).",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "message": { "type": "string" }
              },
              "required": ["type", "message"],
              "additionalProperties": false
            }
          ]
        },
        "superseded_by": {
          "description": "run_id of the next attempt (run_attempt + 1, same series_id, model_key, instance_id and repetition) when the runner repeats this run after api_error; null otherwise. The analysis takes the last attempt.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.v2.schema.json#/$defs/run_id" }
          ]
        }
      },
      "required": ["schema_version", "event", "run_id", "ts", "end_reason", "solved", "done_called", "final_state", "steps", "turns", "counts", "usage_total", "cost", "duration_ms", "error", "superseded_by"],
      "additionalProperties": false,
      "if": { "properties": { "end_reason": { "not": { "const": "api_error" } } } },
      "then": { "properties": { "superseded_by": { "type": "null" } } }
    }
  }
}
